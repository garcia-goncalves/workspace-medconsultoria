# deps
node_modules/
.pnpm-store/

# builds
dist/
build/
*.tsbuildinfo

# env & secrets
.env
.env.*
!.env.example
!.env.production.example

# prisma
packages/db/prisma/*.db

# storage (uploads locais)
storage/

# turbo
.turbo/

# logs
*.log
npm-debug.log*

# editor / os
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
!.env.deploy.example

# Playwright / screenshots de verificação (não são assets do app)
.playwright-mcp/
/*.png
/apps/web/*.png

# Playwright
e2e/.auth/
playwright-report/
test-results/

# Flag de runtime do supervisor keep-alive (MODO PAUSA) — nunca versionar
scripts/.keepalive-pause
scripts/.keepalive.log
scripts/.keepalive.pid

# Versão HTML gerada do tracker (marked) — visualização local, não versionar
AUDITORIA_FUNCIONAL_COMPLETA.html

# Dumps de segurança do banco (podem conter dados reais — nunca versionar)
backups/

# Documentos REAIS de cliente (propostas, listas de credenciamento, contratos assinados).
# Contêm nome de operadora e dados de gente de verdade. Uma vez commitado, fica no
# histórico do git para sempre — não sai com um `rm`. Ficam só no disco, por decisão do
# dono em 11/08/2026. Material de marca SEM dado pessoal (logo, fonte, paleta) pode ser
# versionado normalmente.
brand/identidade/*.pdf
brand/identidade/*.docx

# Pacote temporario de deploy (gerado por build:deploy + tar)
apps/api/bundle-*.tar.gz

# Claude Code - configurações locais
.claude/settings.local.json

# Sobra de build interrompido do tsup (arquivo temporario, as vezes de 0 byte)
tsup.config.bundled_*.mjs

# Relatórios de cobertura (gerados sob demanda por `pnpm cobertura`)
coverage/
cov-unit/
