# Configuração do backup da VPS OVH. Preenchido, este arquivo vira o segredo `BACKUP_ENV` do
# GitHub (gh secret set BACKUP_ENV < backup.env), e o workflow "Instalar backup OVH" o grava na
# VPS em ~/.config/medconsultoria-backup/backup.env, com permissão 600.
#
# ⚠️ Formato: CHAVE=valor, uma por linha, SEM aspas e SEM espaço em volta do "=". O arquivo é
# LIDO linha a linha, não executado — aspas entrariam no valor.
# ⚠️ NÃO vai para o git preenchido (infra/ovh/.gitignore barra `backup/backup.env`).

# ── Destino S3-compatível (OVH Object Storage, Backblaze B2, Cloudflare R2, Wasabi...) ──────────
# O cliente é o rclone, rodando em container (rclone/rclone) — nada é instalado na VPS.
# PROVIDER: "Other" serve para qualquer S3 genérico; para OVH use "Other" com o endpoint da região
# (ex.: https://s3.gra.io.cloud.ovh.net) e REGION "gra"; para Backblaze B2 use "Other" com o
# endpoint S3 do bucket (ex.: https://s3.eu-central-003.backblazeb2.com).
RCLONE_CONFIG_DESTINO_TYPE=s3
RCLONE_CONFIG_DESTINO_PROVIDER=Other
RCLONE_CONFIG_DESTINO_ENDPOINT=
RCLONE_CONFIG_DESTINO_REGION=
RCLONE_CONFIG_DESTINO_ACCESS_KEY_ID=
RCLONE_CONFIG_DESTINO_SECRET_ACCESS_KEY=
# Nome do bucket. ⚠️ Crie-o PRIVADO e, se o provedor oferecer, com "object lock"/versionamento
# desligado para este uso (a retenção é feita pelo script) — ver docs/OPERACAO_OVH.md.
BACKUP_BUCKET=
# Pasta dentro do bucket (permite dividir o bucket com outros projetos do dono).
BACKUP_PREFIXO=medconsultoria

# ── Retenção, aplicada NO DESTINO depois de cada envio ───────────────────────────────────────────
# Todo backup vai para diario/; o de domingo é copiado também para semanal/, e o do dia 1º para
# mensal/. Em cada pasta ficam só os N mais novos.
MANTER_DIARIOS=7
MANTER_SEMANAIS=4
MANTER_MENSAIS=12

# ── Aviso de falha (opcional, RECOMENDADO) ───────────────────────────────────────────────────────
# URL de ping do Healthchecks.io (ou compatível). O script pinga "<url>" no sucesso e
# "<url>/fail" na falha. Configure lá "espera 1 ping por dia, tolerância 2 h": se o backup parar
# de rodar — cron apagado, VPS reinstalada — é ELE quem avisa, porque um script que não roda não
# consegue avisar que não rodou.
HEALTHCHECK_PING_URL=

# ── Onde o projeto mora na VPS (normalmente não precisa mexer) ───────────────────────────────────
PROJETO_DIR=/home/andre/medconsultoria
# Volume nomeado dos uploads (nome do projeto no compose + "_uploads").
VOLUME_UPLOADS=medconsultoria_uploads
# Tamanho do disco em memória do banco descartável do ensaio de restauração. Em memória para não
# disputar o disco da VPS compartilhada (lição de 21/09/2026). Deixe vazio para usar o disco.
ENSAIO_TMPFS_TAMANHO=1g
