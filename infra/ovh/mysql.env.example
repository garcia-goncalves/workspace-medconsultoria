# Modelo do ~/medconsultoria/mysql.env da VPS — o ambiente SÓ do container do banco.
# Copie para `mysql.env`, preencha e deixe em 600 (chmod 600 mysql.env). NÃO vai para o git.
#
# ⚠️ OS VALORES SÃO COPIADOS DO `.env` ATUAL, NUNCA INVENTADOS. O volume do banco já foi
# inicializado: o MySQL ignora MYSQL_DATABASE/USER/PASSWORD daqui em diante, mas o healthcheck do
# compose e o backup usam MYSQL_ROOT_PASSWORD — uma senha diferente da real deixa o banco
# "unhealthy" para sempre (e o app, que depende dele, não sobe).
#
# Receita, dentro de ~/medconsultoria (não imprime nada na tela):
#   ( umask 077; grep -E '^MYSQL_(ROOT_PASSWORD|DATABASE|USER|PASSWORD)=' .env > mysql.env )
#   wc -l mysql.env        ← tem de dizer 4

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
