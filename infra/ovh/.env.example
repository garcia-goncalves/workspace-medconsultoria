# Modelo do /srv/medconsultoria/.env do VPS (ADR-154). Copie, preencha, e deixe em 600.
#
# ⚠️ AS DUAS CHAVES DE CIFRA SÃO COPIADAS DA PRODUÇÃO ATUAL, NUNCA GERADAS DE NOVO.
# Gerar outra PACIENTE_CRYPTO_KEY torna ilegível todo dado de paciente já importado (o conserto
# seria reimportar cada competência); outra EMAIL_CRYPTO_KEY derruba toda caixa de e-mail plugada.
# Elas estão no .env do servidor antigo — dá para ler pelo File Manager do painel, sem SSH.

# ── Onde a imagem mora ───────────────────────────────────────────────────────────────────────
APP_IMAGE=ghcr.io/garcia-goncalves/workspace-medconsultoria:main
DOMINIO=workspace.medconsultoria.com.br

# ── Banco ────────────────────────────────────────────────────────────────────────────────────
# A URL do Prisma: esquema `mysql`, o usuário e a senha que você puser abaixo, host **mysql**
# (o nome do serviço na rede do compose — nunca `localhost`), porta 3306 e o banco do
# MYSQL_DATABASE. Preencha aqui, no servidor; este arquivo preenchido NÃO vai para o git.
DATABASE_URL=
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=medconsultoria
MYSQL_USER=medconsultoria
MYSQL_PASSWORD=

# ── Aplicação ────────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
API_PORT=4319
WEB_ORIGIN=https://workspace.medconsultoria.com.br
SESSION_SECRET=
UPLOADS_DIR=/dados/uploads   # absoluto: o app recusa relativo em produção

# ── Chaves de cifra — COPIADAS, ver aviso no topo ────────────────────────────────────────────
EMAIL_CRYPTO_KEY=
PACIENTE_CRYPTO_KEY=

# ── Integrações (copiar do .env atual) ───────────────────────────────────────────────────────
GEMINI_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
