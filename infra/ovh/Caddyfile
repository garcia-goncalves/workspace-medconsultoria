# TLS automático (Let's Encrypt) e proxy para o app. Mora em /srv/medconsultoria/Caddyfile.
#
# É o que substitui o LiteSpeed + `.htaccess` da hospedagem antiga — aquele que não podia ser
# apagado porque era ele que fazia o site existir, e que por isso proibia `rsync --delete`.
#
# ⚠️ O certificado só é emitido quando o DNS do domínio JÁ aponta para este servidor. Antes do
# cutover, use o subdomínio de homologação (que você pode apontar sem mexer na produção).

{$DOMINIO} {
	encode zstd gzip

	# O app serve o SPA e a API no mesmo processo (dist/public + tRPC), como já era.
	reverse_proxy app:4319 {
		health_uri /health
		health_interval 15s
	}

	log {
		output file /data/acesso.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
