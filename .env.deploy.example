# ─────────────────────────────────────────────────────────────
# Copie para .env.deploy (que NUNCA é commitado) e preencha.
# Usado por ./deploy.sh. NÃO coloque senhas do MySQL aqui — elas
# vão no .env DO SERVIDOR (produção), não neste arquivo.
# ─────────────────────────────────────────────────────────────

# Servidor SSH da TineHost (dados NÃO-secretos).
# A porta é 1992, não 22 — o padrão do SSH não atende aqui.
DEPLOY_HOST="ex-123.45.67.89-ou-ssh.seudominio.com.br"
DEPLOY_USER="seu-usuario-directadmin"
DEPLOY_SSH_PORT="1992"

# ⚠️ CAMINHO REAL DA APLICAÇÃO. O App Root é o `public_html` do subdomínio — NÃO uma pasta
# `app/` nem `~/workspace-medconsultoria`. Um valor errado aqui faz o deploy morrer no envio
# (aconteceu em 10/08/2026, com `.../app`, que não existe). Confira no DirectAdmin antes.
DEPLOY_PATH="/home3/SEU_USUARIO/domains/workspace.medconsultoria.com.br/public_html"

# Autenticação SSH: PREFIRA CHAVE (não senha). Caminho da sua chave privada.
# A chave usada pelo GitHub Actions vive em Secrets e NÃO pode ser lida de volta — para
# publicar da sua máquina, gere um par próprio e ponha a pública no servidor
# (DirectAdmin → SSH Keys, ou ~/.ssh/authorized_keys). Ver docs/DEPLOY.md §2.
DEPLOY_SSH_KEY="C:/Users/andre/.ssh/medconsultoria_deploy"

# ── Opcionais (só mexa se souber por quê) ────────────────────
# Virtualenv do Node no CloudLinux — onde `npm` e `node` de verdade moram.
# DEPLOY_NODE_VENV="~/nodevenv/domains/workspace.medconsultoria.com.br/public_html/20/bin/activate"
# Domínio conferido no smoke test do fim.
# DEPLOY_DOMINIO="https://workspace.medconsultoria.com.br"
