// Schema do Workspace MedConsultoria — MySQL.
// Convenções (ver docs/DATABASE.md): PK cuid, createdAt/updatedAt, soft delete onde faz sentido.
// Fase 0 cria apenas Identidade & Acesso. As demais entidades entram fase a fase.

generator client {
  provider      = "prisma-client-js"
  // "native" cobre a máquina onde o `prisma generate` roda. Os demais são gerados JUNTO, para
  // o servidor.
  //
  // Por que é necessário: na TineHost (CloudLinux), o shell do SSH e o processo do Passenger
  // reportam OpenSSL DIFERENTES. O generate rodado por SSH produzia só o engine
  // `debian-openssl-1.1.x`, e o app subia normalmente na mão — mas sob o Passenger estourava
  // `Prisma Client could not locate the Query Engine for runtime "debian-openssl-1.0.x"`,
  // devolvendo HTTP 500 sem nenhuma pista na página.
  binaryTargets = ["native", "debian-openssl-1.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Papéis do sistema (RBAC). Espelha ROLES em packages/shared.
enum Role {
  ROOT
  ADMIN
  FUNCIONARIO
  CLIENTE
}

/// Papel de uma pessoa DENTRO da clínica, no Portal do Cliente. Espelha PORTAL_PAPEIS em
/// packages/shared. Só faz sentido em `User.role = CLIENTE`; nulo em conta interna.
///
/// Separa quem FALA PELA CLÍNICA (aceita proposta, contrata e cancela serviço) de quem toca o
/// operacional (envia documento, responde formulário, fala com o suporte). A regra de o que cada
/// um pode está em `podeNoPortal`, e é uma lista de LIBERAÇÕES: o padrão é negar.
enum PortalPapel {
  RESPONSAVEL
  EQUIPE
}

/// Situação comercial da conta (Cliente). Estrutura controlada (enum) — ver decisão técnica #1.
/// PROSPECT/NEGOCIACAO/PERDIDO = estados do funil; ATIVO/INATIVO = cliente de verdade.
enum SituacaoComercial {
  PROSPECT
  NEGOCIACAO
  ATIVO
  INATIVO
  PERDIDO
}

/// Usuário interno ou cliente do Portal.
model User {
  id               String       @id @default(cuid())
  nome             String
  email            String       @unique
  // Nulo enquanto o convite não foi aceito (usuário "pendente", sem senha definida).
  passwordHash     String?
  role             Role         @default(FUNCIONARIO)
  ativo            Boolean      @default(true)
  avatarUrl        String?
  // Quando a pessoa definiu a PRÓPRIA senha (trocar/convite/reset). Nulo = nunca definiu —
  // a conta ainda usa a senha compartilhada do seed e é convidada a trocar no 1º acesso.
  senhaTrocadaEm   DateTime?
  /// Última vez que a pessoa ENTROU de verdade (login com senha). Nulo = nunca entrou.
  /// Serve ao card do lead/cliente: sem ele, a Thaís sabe que mandou o convite mas não sabe se
  /// alguém apareceu — e é justamente "convidei e ninguém entrou" que ela precisa cobrar.
  /// ⚠️ NÃO é atualizado por sessão de suporte da equipe: o número tem de responder "o CLIENTE
  /// veio?", e nós entrarmos no painel dele não é o cliente vindo.
  ultimoAcessoEm   DateTime?
  // Se role = CLIENTE, define o escopo do Portal (FK adicionada quando o módulo Cliente existir).
  clienteId        String?
  /// PAPEL DENTRO DA CLÍNICA (ADR-131). Nulo em conta interna — e nulo também nas contas de
  /// Portal criadas antes desta regra, que `podeNoPortal` trata como RESPONSAVEL de propósito:
  /// eram a conta única da clínica e sempre puderam tudo. Rebaixá-las em silêncio tiraria o
  /// poder de assinar de quem já assinava, e a clínica só descobriria na hora de aceitar uma
  /// proposta. A migração marca as existentes explicitamente, para a tela não ficar muda.
  papelPortal      PortalPapel?
  /// Quem convidou esta pessoa para o Portal. Serve à pergunta "quem deu acesso a essa
  /// secretária?" — que é uma pergunta de auditoria, não de curiosidade. Pode ser alguém da
  /// equipe da Med OU o responsável da própria clínica.
  convidadoPorId   String?
  /// QUANDO O ACESSO FOI TIRADO (ADR-131). Nulo = nunca foi revogado.
  ///
  /// ⚠️ Existe porque `ativo = false` sozinho é AMBÍGUO, e a tela mostrou isso na primeira
  /// rodada de teste: conta convidada e ainda sem senha também nasce inativa, então a
  /// secretária recém-convidada aparecia na lista como **"acesso revogado"** — dizendo à
  /// clínica que tiramos um acesso que acabáramos de dar. Um marcador explícito separa "ainda
  /// não entrou" de "não entra mais", e de quebra responde *quando* o acesso caiu.
  acessoRevogadoEm DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  sessions             Session[]
  sessoesDeSuporte     Session[]              @relation("SessaoDeSuporte")
  activityLogs         ActivityLog[]
  cliente              Cliente?               @relation("UserCliente", fields: [clienteId], references: [id], onDelete: SetNull)
  clientesResponsavel  Cliente[]              @relation("ClienteResponsavel")
  leadsResponsavel     Lead[]                 @relation("LeadResponsavel")
  projetosResponsavel  Projeto[]              @relation("ProjetoResponsavel")
  projetosParticipa    ProjetoParticipante[]
  cardsResponsavel     Card[]                 @relation("CardResponsavel")
  timeEntries          TimeEntry[]
  notas                Nota[]
  eventos              Evento[]               @relation("EventoDono")
  eventoParticipacoes  EventoParticipante[]
  notificacoes         Notificacao[]
  mensagens            Mensagem[]
  conversaParticipa    ConversaParticipante[]
  conversasResponsavel Conversa[]             @relation("ConversaResponsavel")
  conversasCriadas     Conversa[]             @relation("ConversaCriador")
  documentosCriados    Documento[]            @relation("DocCriador")
  documentosAprovados  Documento[]            @relation("DocAprovador")
  // Trilha de quem aceitou/assinou estando logado (ADR-137).
  propostasRespondidas Documento[]            @relation("PropostasRespondidas")
  assinaturasFeitas    Assinatura[]           @relation("AssinaturasFeitas")
  clientesAnonimizados Cliente[]              @relation("ClientesAnonimizados")
  documentoVersoes     DocumentoVersao[]
  suporteMensagens     SuporteMensagem[]
  tokens               Token[]
  preferenciasEmail    PreferenciaEmail[]
  contas               Conta[]                @relation("ContaDono")
  categorias           Categoria[]            @relation("CategoriaDono")
  tarefasCriadas       Tarefa[]               @relation("TarefaCriador")
  tarefasResponsavel   TarefaResponsavel[]
  caixasEmail          CaixaEmail[]
  convidadoPor         User?                  @relation("ConvitePortal", fields: [convidadoPorId], references: [id], onDelete: SetNull)
  convidou             User[]                 @relation("ConvitePortal")
  // API DO AGENTE (ADR-149): delegações emitidas EM NOME desta pessoa, e as que ela emitiu.
  delegacoesDeAgente   AgentDelegation[]      @relation("DelegacaoDoUsuario")
  delegacoesEmitidas   AgentDelegation[]      @relation("DelegacaoEmitidaPor")
  idempotenciasDeAgente AgentIdempotency[]   @relation("IdempotenciaDoAgente")

  @@index([role])
  @@index([clienteId])
  @@index([convidadoPorId])
}

/// Personalização (override) do conteúdo de um e-mail transacional. Ausência = usa o padrão do código.
model EmailTemplate {
  chave         String   @id
  assunto       String
  titulo        String
  corpo         String   @db.Text // parágrafos separados por linha em branco; aceita {{variaveis}}
  ctaTexto      String?
  nota          String?  @db.Text
  atualizadoPor String?
  atualizadoEm  DateTime @updatedAt
}

/// Preferência de recebimento de e-mail por categoria. Ausência de linha = habilitado (opt-out).
model PreferenciaEmail {
  id     String  @id @default(cuid())
  userId String
  tipo   String
  ativo  Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tipo])
  @@index([userId])
}

/// Token de uso único (convite de acesso / redefinição de senha). Guarda só o HASH.
model Token {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  tipo      String // "CONVITE" | "RESET"
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Sessão persistida (permite revogação). Referenciada pelo cookie httpOnly.
model Session {
  id                  String   @id @default(cuid())
  userId              String
  expiresAt           DateTime
  userAgent           String?  @db.Text
  ip                  String?
  createdAt           DateTime @default(now())
  /// SESSÃO DE SUPORTE (ADR-128) — quem da EQUIPE abriu esta sessão para ver o Portal de um
  /// cliente. Nulo na esmagadora maioria: sessão normal é a pessoa entrando como ela mesma.
  ///
  /// Existe porque "entrar como o cliente" sem marcar quem entrou faz o histórico culpar o
  /// CLIENTE por tudo o que a equipe fizer lá dentro — e o cliente reclamaria de algo que não
  /// fez, com o próprio sistema dando razão a ele. Com este campo, `userId` continua sendo o
  /// dono do Portal (o isolamento do `portalProcedure` não muda uma linha) e o registro sabe
  /// dizer "Thaís, vendo como Clínica X".
  operadorId          String?
  /// A sessão do OPERADOR, para o botão "voltar ao meu acesso" não pedir login de novo. A
  /// sessão original continua viva enquanto a de suporte existe; voltar é trocar o cookie.
  /// Sem FK de propósito: se a original expirar antes, voltar simplesmente manda para o login.
  voltarParaSessionId String?

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SetNull: apagar quem deu suporte não apaga a sessão nem some com o rastro do acesso.
  operador User? @relation("SessaoDeSuporte", fields: [operadorId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@index([operadorId])
}

/// Log de auditoria genérico — alimenta timelines e rastreio LGPD.
model ActivityLog {
  id           String   @id @default(cuid())
  userId       String?
  acao         String
  entidadeTipo String?
  entidadeId   String?
  dados        Json?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entidadeTipo, entidadeId])
  @@index([createdAt])
}

/// Erros do servidor agrupados por fingerprint (estilo "issue" do Sentry) — capturado
/// automaticamente para o painel do ROOT. Ocorrências idênticas somam no mesmo registro.
model ErrorLog {
  id          String    @id @default(cuid())
  fingerprint String    @unique
  rota        String?
  mensagem    String    @db.Text
  stack       String?   @db.Text
  userId      String?
  ocorrencias Int       @default(1)
  resolvido   Boolean   @default(false)
  resolvidoEm DateTime?
  regrediu    Boolean   @default(false)
  ignorado    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  ultimaVez   DateTime  @default(now())

  @@index([resolvido, ultimaVez])
}

/// Incidente aberto automaticamente pelo motor de alertas quando um sinal cruza o
/// limiar (com histerese/período de espera). Guarda histórico + MTTR para o painel.
model Incidente {
  id            String    @id @default(cuid())
  regra         String
  titulo        String
  severidade    String // "degradado" | "critico"
  componente    String
  detalhe       String    @db.Text
  status        String    @default("ABERTO") // ABERTO | RECONHECIDO | RESOLVIDO
  valorPico     Float?
  createdAt     DateTime  @default(now())
  reconhecidoEm DateTime?
  resolvidoEm   DateTime?

  @@index([status, createdAt])
}

// ─────────────────────────────────────────────────────────────
// CRM (Fase 1)
// ─────────────────────────────────────────────────────────────

/// Cliente da MedConsultoria — espinha dorsal do sistema.
model Cliente {
  id                String            @id @default(cuid())
  nome              String
  // Todo cliente da Med é pessoa jurídica — médico e clínica são PJ (ADR-119). Por isso
  // não existe campo "tipo": não há PF a distinguir, e o documento é sempre CNPJ.
  cnpj              String? // sempre CNPJ (aceita o formato alfanumérico de 2026)
  email             String?
  telefone          String?
  observacoes       String?           @db.Text
  // Estágio na relação comercial: PROSPECT | NEGOCIACAO | ATIVO | PERDIDO (usado a partir da Fase 3).
  situacaoComercial SituacaoComercial @default(ATIVO)
  /// LGPD (ADR-141) — quando o titular pediu a eliminação e os dados foram substituídos por
  /// marcador. Eliminar de verdade é impossível aqui: contrato, nota e credenciamento têm
  /// guarda obrigatória, e o `excluirDefinitivoCliente` bloqueia diante de QUALQUER vínculo.
  /// Anonimizar é a saída que a lei aceita quando há dever de guarda. Nulo = caso normal.
  anonimizadoEm     DateTime?
  anonimizadoPorId  String?
  responsavelId     String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  responsavel         User?                @relation("ClienteResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  anonimizadoPor      User?                @relation("ClientesAnonimizados", fields: [anonimizadoPorId], references: [id], onDelete: SetNull)
  contatos            Contato[]
  usuariosPortal      User[]               @relation("UserCliente")
  leadsConvertidos    Lead[]               @relation("LeadConvertido")
  leadsPortal         Lead[]               @relation("LeadClientePortal")
  projetos            Projeto[]
  eventos             Evento[]
  contas              Conta[]
  documentos          Documento[]
  suporteMensagens    SuporteMensagem[]
  conversas           Conversa[]
  servicosContratados ClienteServico[]
  arquivos            Arquivo[]
  respostasFormulario FormularioResposta[]
  tarefas             Tarefa[]
  profissionais       Profissional[]
  credenciamentos     Credenciamento[]

  @@index([responsavelId])
  @@index([deletedAt])
}

/// Mensagem do canal de SUPORTE de um cliente (Portal ↔ equipe). Isolado por clienteId.
model SuporteMensagem {
  id        String   @id @default(cuid())
  clienteId String
  autorId   String
  corpo     String   @db.Text
  daEquipe  Boolean // true = enviada pela equipe; false = pelo cliente (Portal)
  lida      Boolean  @default(false) // lida pela outra parte
  createdAt DateTime @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  autor   User    @relation(fields: [autorId], references: [id], onDelete: Cascade)

  @@index([clienteId, createdAt])
}

/// Pessoa de contato dentro de um Cliente (especialmente PJ).
model Contato {
  id        String   @id @default(cuid())
  clienteId String
  nome      String
  cargo     String?
  email     String?
  telefone  String?
  principal Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
}

/// Anotação polimórfica (entidadeTipo + entidadeId). Ex.: ("cliente", <id>).
/// Junto com o ActivityLog forma a timeline da entidade.
/// Nota da timeline (cliente/lead). HISTÓRICO IMUTÁVEL: o conteúdo NUNCA é editado/apagado.
/// Correção/complemento = nova nota; "esconder" = arquivar (arquivadaEm) sem apagar. Ver decisão #2.
model Nota {
  id             String    @id @default(cuid())
  autorId        String?
  entidadeTipo   String
  entidadeId     String
  conteudo       String    @db.Text
  createdAt      DateTime  @default(now())
  /// Arquivamento reversível (não apaga o histórico). Nota arquivada some das visões ativas.
  arquivadaEm    DateTime?
  arquivadaPorId String?

  autor User? @relation(fields: [autorId], references: [id], onDelete: SetNull)

  @@index([entidadeTipo, entidadeId])
  @@index([autorId])
}

/// Coluna do funil de vendas (kanban de Leads). Ordenável.
model PipelineStage {
  id        String   @id @default(cuid())
  nome      String
  ordem     Int
  cor       String?
  // Chave semântica estável para a automação (ex.: "qualificacao", "proposta").
  // Sobrevive a renomear/reordenar; etapas personalizadas ficam sem chave (null).
  chaveAuto String?
  createdAt DateTime @default(now())

  leads Lead[]

  @@index([ordem])
}

/// Catálogo de origens de lead (editável). De onde o lead veio — alimenta o
/// autocomplete do campo "Origem" e padroniza os valores.
model Origem {
  id        String   @id @default(cuid())
  nome      String
  ativo     Boolean  @default(true)
  ordem     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([ordem])
}

/// Catálogo de operadoras/convênios para a Proposta de credenciamento (editável: a equipe
/// renomeia e exclui permanentemente). Semeado com as operadoras comuns na primeira leitura.
/// OPERADORA / CONVÊNIO — **um cadastro só**, usado por dois serviços diferentes (ADR-126).
///
/// A mesma Unimed que se credencia é a Unimed cujas contas se faturam. Manter duas listas faria
/// a Thaís cadastrar o mesmo nome duas vezes e, pior, deixaria as duas divergirem com o tempo —
/// a de credenciamento atualizada, a de faturamento esquecida. O que muda de um serviço para o
/// outro é só PARA QUAL DELES aquela operadora serve, e isso são duas marcações.
///
/// Ambas nascem `true`: as operadoras que já existiam entram marcadas nas duas, senão a
/// primeira proposta de faturamento abriria com a lista vazia e pareceria defeito.
model Operadora {
  id                String   @id @default(cuid())
  nome              String
  ordem             Int      @default(0)
  /// Aparece na seleção da proposta de CREDENCIAMENTO e na grade médico × operadora.
  usoCredenciamento Boolean  @default(true)
  /// Aparece na seleção de convênios atendidos da proposta de FATURAMENTO.
  usoFaturamento    Boolean  @default(true)
  createdAt         DateTime @default(now())

  credenciamentos Credenciamento[]
  /// Convênios que o cliente atende, por serviço contratado (ADR-126).
  clienteServicos ClienteServico[] @relation("ClienteServicoOperadoras")

  @@index([ordem])
}

/// IDENTIDADE INSTITUCIONAL — linha única (singleton, id "default"), editável pela Thaís em
/// Ajustes → Dados da empresa. É a fonte da verdade que alimenta contratos, propostas e e-mails.
/// Semeada com os dados de contato reais; os campos jurídicos (razão social, CNPJ, endereço, foro)
/// começam nulos e só ela preenche — nada de CNPJ inventado num contrato. Ver institucional.ts.
model IdentidadeInstitucional {
  id                      String   @id @default("default")
  // Marca e contato (cliente-facing)
  nome                    String
  tagline                 String
  site                    String
  siteUrl                 String
  email                   String
  telefone                String
  cidade                  String
  instagram               String
  instagramUrl            String
  // Dados jurídicos — a Thaís preenche; enquanto nulos, saem como marcador visível "[A PREENCHER]"
  razaoSocial             String?  @db.Text
  cnpj                    String?
  enderecoCompleto        String?  @db.Text
  foro                    String?  @db.Text
  /// DADOS PARA PAGAMENTO — o bloco `{{dadosPagamento}}` das propostas. Moram aqui, e não no
  /// corpo do modelo, porque conta bancária é dado da EMPRESA e muda uma vez a cada anos: quem
  /// digita é a Thaís, em Ajustes → Dados da empresa, sem publicação nenhuma. Todos nuláveis de
  /// propósito — enquanto estiverem em branco, o bloco inteiro SOME do papel, em vez de sair
  /// pela metade com "Agência: " vazio na frente do cliente. A proposta de CREDENCIAMENTO não
  /// mostra este bloco: ali a Thaís só cobra depois do sucesso na operadora (ADR-104).
  bancoNome               String?
  bancoAgencia            String?
  bancoConta              String?
  bancoTitular            String?  @db.Text
  pixChave                String?
  /// A partir de quantos dias sem andar um credenciamento pede atenção no painel.
  /// 60 é o prazo real das operadoras, dito pela Thaís em 11/08/2026. Editável porque
  /// operadora muda de ritmo e ela não deve precisar de alteração de código para ajustar.
  credenciamentoPrazoDias Int      @default(60)
  /// LGPD (ADR-141) — PRAZOS DE GUARDA, editáveis em Ajustes porque prazo é decisão de
  /// negócio, não de código. Depois deste prazo o CORPO do e-mail é apagado; o metadado
  /// (para quem, assunto, quando, entregue ou não) FICA, que é do que o monitor precisa.
  retencaoCorpoEmailDias  Int      @default(180)
  /// Anos de guarda do acervo de credenciamento depois de encerrado o contrato. O sistema
  /// AVISA que passou do prazo; NUNCA apaga sozinho — apagar o diploma de um médico por
  /// conta própria é pior que guardar demais.
  retencaoAcervoAnos      Int      @default(5)
  /// Encarregado de dados (DPO) da LGPD. Nulos enquanto o dono não indicar alguém: a
  /// página de privacidade cai no e-mail institucional e diz que o canal é esse.
  encarregadoNome         String?
  encarregadoEmail        String?
  atualizadoEm            DateTime @updatedAt
}

/// Catálogo de serviços da MedConsultoria (editável). O lead marca no cadastro o
/// que precisa; guia proposta/briefing/contrato e, ao fechar, vira tarefas do projeto.
/// Como um valor de serviço é cobrado: uma única vez (avulso) ou todo mês (recorrente).
enum PrecoRecorrencia {
  AVULSO
  MENSAL
}

model Servico {
  id                    String           @id @default(cuid())
  nome                  String
  descricao             String?          @db.Text
  categoria             String? // agrupa o catálogo: Gestão | Faturamento | Networking | Desenvolvimento | Marketing
  // Precificação flexível: um serviço pode ter valor fixo e/ou % do faturamento do cliente,
  // e cada componente pode ser avulso (1x) ou mensal (recorrente). Ambos opcionais.
  valor                 Decimal?         @db.Decimal(12, 2) // valor fixo de referência (opcional)
  valorRecorrencia      PrecoRecorrencia @default(AVULSO)
  percentual            Decimal?         @db.Decimal(12, 2) // % sobre o faturamento do cliente, ex.: 5 = 5% (opcional)
  percentualRecorrencia PrecoRecorrencia @default(MENSAL)
  // Roteiro do projeto: as TAREFAS (cada uma vira um cartão) e o checklist de cada uma,
  // criadas automaticamente quando o serviço é contratado. JSON: [{ titulo, itens: [] }].
  roteiro               Json?
  // Cláusulas de contrato específicas deste serviço (Markdown). Entram no CONTRATO gerado
  // automaticamente quando o cliente aceita a proposta, juntando as cláusulas de todos os
  // serviços contratados. Editável na tela de Serviços.
  clausulasContrato     String?          @db.Text
  /// Condição de pagamento deste serviço, em português, como sai na PROPOSTA. Existe porque a
  /// condição do Faturamento é sempre a mesma frase contratual ("o repasse é após o crédito na
  /// conta da clínica") e dependia de alguém lembrar de digitá-la em toda proposta — proposta
  /// muda sobre quando se paga é discussão garantida depois. Mora aqui, e não no código, pelo
  /// mesmo motivo de `clausulasContrato`: quem escreve o texto comercial é a Thaís, na tela de
  /// Serviços, sem precisar de uma publicação para mudar uma vírgula. Ver ADR-125.
  condicaoPagamento     String?          @db.Text
  /// ESTE SERVIÇO É O CREDENCIAMENTO? É a marca que decide TRÊS regras de dinheiro: ficar fora
  /// da estimativa do funil, ficar fora do provisionamento da conversão do lead, e ter o
  /// honorário nascendo só quando a operadora APROVA (ADR-104/108).
  /// Existe porque até aqui a identificação era por NOME: bastava corrigir um typo em
  /// Ajustes → Serviços para o cliente passar a ser cobrado na conversão e DE NOVO na
  /// aprovação. A ADR-140 chamou isso de remendo assumido e apontou este campo como a cura.
  /// ⚠️ NÃO EXISTE LADO SEGURO PARA ERRAR AQUI, e o padrão `false` não é um deles: um
  /// credenciamento marcado como `false` volta a ser cobrado na conversão do lead E na
  /// aprovação da operadora — as duas cobranças. O padrão é `false` porque serviço novo é
  /// comum; para o credenciamento, quem garante a marca é a semeadura do catálogo e o backfill
  /// da migração, e a migração seguinte (`20260829210500`) PARA a publicação se nenhuma linha
  /// tiver sido marcada, em vez de deixar o dinheiro sair errado em silêncio.
  ehCredenciamento      Boolean          @default(false)
  /// ESTE SERVIÇO É O FATURAMENTO MÉDICO? É a marca que decide QUEM PODE SER COBRADO POR
  /// PERCENTUAL do que a clínica fatura. Ordem do dono (31/08/2026): **só o faturamento médico
  /// é percentual; todo o resto do catálogo é valor fixo**, avulso ou mensal.
  /// Existe porque a tela oferecia o botão "% do faturamento" nos DEZ serviços — inclusive no
  /// credenciamento, que é valor fixo cobrado só no sucesso da operadora. Trocar a forma de
  /// cobrança de um serviço por engano não dá erro nenhum: muda o preço no papel do cliente, na
  /// conta a receber e na estimativa do funil, todos em silêncio.
  /// ⚠️ É uma MARCA, e não `categoria === "Faturamento"`: essa comparação já foi escrita e
  /// removida CINCO vezes (ADR-125/126/127/137/138) porque bastava renomear a categoria em
  /// Ajustes para o dinheiro mudar de regra. Mesmo molde de `ehCredenciamento` (ADR-144).
  /// ⚠️ Só UM serviço pode estar marcado, e nenhum serviço pode ser as DUAS marcas ao mesmo
  /// tempo — o servidor recusa, dizendo qual já está marcado.
  /// ⚠️ Quem NÃO está marcado não pode ter `percentual`; o servidor recusa gravar.
  ehFaturamento         Boolean          @default(false)
  ativo                 Boolean          @default(true)
  ordem                 Int              @default(0)
  createdAt             DateTime         @default(now())

  leads        Lead[]             @relation("LeadServicos")
  passos       ServicoPasso[]
  requisitos   ServicoRequisito[]
  contratacoes ClienteServico[]
  arquivos     Arquivo[]
  cards        Card[]
  projetos     Projeto[]

  /// O nome IDENTIFICA o serviço, e por isso não pode repetir: a semeadura do catálogo casa
  /// por nome (`semearCatalogoSeFaltar`) e a proposta lista os dois lado a lado sem nada que os
  /// distinga. Ver a guarda da migração, que PARA a publicação se já houver duplicata.
  @@unique([nome])
  @@index([ordem])
}

/// Vínculo direto Cliente ↔ Serviço: o que o cliente REALMENTE contratou (fonte da
/// verdade dos "serviços contratados", antes derivada dos leads ganhos). A equipe liga
/// direto (origem MANUAL); a conversão de um lead ganho gera as contratações (origem
/// FUNIL). Cancelável pelos dois lados (equipe ou cliente pelo Portal).
model ClienteServico {
  id                    String           @id @default(cuid())
  clienteId             String
  servicoId             String
  status                String           @default("ATIVO") // ATIVO | CANCELADO
  origem                String           @default("MANUAL") // MANUAL | FUNIL
  // O que o cliente REALMENTE paga (herdado do serviço ao contratar; editável). Mesma
  // estrutura da precificação do catálogo (ADR-33): valor fixo + recorrência, e % mensal.
  valor                 Decimal?         @db.Decimal(12, 2)
  valorRecorrencia      PrecoRecorrencia @default(AVULSO)
  percentual            Decimal?         @db.Decimal(12, 2)
  percentualRecorrencia PrecoRecorrencia @default(MENSAL)
  observacao            String?          @db.Text
  contratadoEm          DateTime         @default(now())
  canceladoEm           DateTime?
  canceladoPorTipo      String? // EQUIPE | CLIENTE
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  cliente    Cliente     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  servico    Servico     @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  /// Os convênios que o cliente atende NESTE serviço (ADR-126). Nasce do que foi marcado na
  /// proposta de faturamento e continua editável na ficha — a lista de convênios muda com o
  /// tempo e é dado do cliente, não do documento que a originou.
  operadoras Operadora[] @relation("ClienteServicoOperadoras")

  @@unique([clienteId, servicoId])
  @@index([clienteId])
  @@index([servicoId])
}

/// Exigência (item de checklist) de um serviço: o que é preciso para executá-lo.
/// tipo DOCUMENTO = o cliente envia um arquivo (upload). tipo BRIEFING = o cliente
/// preenche um formulário online (Fase 1B). Editável pela Thaís na página Serviços.
model ServicoRequisito {
  id                 String   @id @default(cuid())
  servicoId          String
  titulo             String
  descricao          String?  @db.Text
  tipo               String   @default("DOCUMENTO") // DOCUMENTO | BRIEFING
  obrigatorio        Boolean  @default(true)
  ordem              Int      @default(0)
  formularioId       String? // quando tipo = BRIEFING: o formulário online a preencher
  // Credenciamento (ADR-103): a quem o documento pertence — EMPRESA | CLINICA |
  // PROFISSIONAL | RESPONSAVEL_TECNICO (validado em @app/shared). Ausente = comportamento
  // de sempre: uma vaga só, sem vínculo com médico.
  escopo             String?
  // Divide a exigência em DUAS vagas de envio (frente e verso do mesmo documento).
  frenteVerso        Boolean  @default(false)
  // Marca a exigência que TRAVA a elegibilidade: ALVARA_FUNCIONAMENTO | ALVARA_VIGILANCIA |
  // CNES | TITULO_ESPECIALISTA. É a chave, e não o título, que a triagem consulta — assim
  // renomear o documento na tela não quebra a regra.
  travaElegibilidade String?
  createdAt          DateTime @default(now())

  servico        Servico              @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  arquivos       Arquivo[]
  formulario     Formulario?          @relation(fields: [formularioId], references: [id], onDelete: SetNull)
  respostas      FormularioResposta[]
  checklistItens ChecklistItem[]

  @@index([servicoId])
}

/// Formulário/briefing online REUTILIZÁVEL (ex.: "Briefing de site"). O cliente preenche
/// direto na tela (ou baixa). Ligado a um ServicoRequisito do tipo BRIEFING.
model Formulario {
  id        String   @id @default(cuid())
  titulo    String
  descricao String?  @db.Text
  ativo     Boolean  @default(true)
  // interno = criado automaticamente para um requisito do tipo INFORMACAO (pergunta única);
  // não aparece no catálogo de Formulários (é gerido junto com o requisito).
  interno   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campos     FormularioCampo[]
  requisitos ServicoRequisito[]
  respostas  FormularioResposta[]
}

/// Um campo (pergunta) de um Formulario.
model FormularioCampo {
  id           String  @id @default(cuid())
  formularioId String
  rotulo       String
  tipo         String  @default("TEXTO_CURTO") // TEXTO_CURTO|TEXTO_LONGO|ESCOLHA|MULTIPLA|NUMERO|SIM_NAO|DATA
  obrigatorio  Boolean @default(false)
  opcoes       String? @db.Text // JSON array de opções (ESCOLHA|MULTIPLA)
  ajuda        String? // dica exibida ao cliente
  ordem        Int     @default(0)

  formulario Formulario @relation(fields: [formularioId], references: [id], onDelete: Cascade)

  @@index([formularioId])
}

/// Resposta de um cliente a um Formulario (por requisito). Preenchida online no Portal.
model FormularioResposta {
  id           String    @id @default(cuid())
  formularioId String
  clienteId    String
  requisitoId  String?
  servicoId    String?
  respostas    String    @db.Text // JSON { campoId: valor }
  status       String    @default("RASCUNHO") // RASCUNHO | ENVIADO
  enviadoEm    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  formulario Formulario        @relation(fields: [formularioId], references: [id], onDelete: Cascade)
  cliente    Cliente           @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  requisito  ServicoRequisito? @relation(fields: [requisitoId], references: [id], onDelete: SetNull)

  @@index([clienteId])
  @@index([formularioId])
  @@index([requisitoId])
}

/// Arquivo enviado (upload) — pelo CLIENTE (Portal) ou pela EQUIPE (ficha). Guardado
/// no disco (UPLOADS_DIR); aqui ficam só os metadados + o caminho relativo. Pode estar
/// ligado a um serviço/requisito (atende uma exigência) ou ser um documento avulso.
model Arquivo {
  id             String    @id @default(cuid())
  nome           String // nome original (exibição)
  mimetype       String
  tamanho        Int
  caminho        String // caminho relativo dentro de UPLOADS_DIR
  clienteId      String
  servicoId      String?
  requisitoId    String?
  // Credenciamento (ADR-103): de QUAL médico é este arquivo, e qual lado do documento.
  // Opcionais — arquivo antigo continua válido sem elas.
  profissionalId String?
  lado           String? // FRENTE | VERSO (validado em @app/shared)
  enviadoPorTipo String // CLIENTE | EQUIPE
  enviadoPorId   String? // userId de quem enviou (null se sessão de cliente sem user? sempre há user)
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  cliente      Cliente           @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  servico      Servico?          @relation(fields: [servicoId], references: [id], onDelete: SetNull)
  requisito    ServicoRequisito? @relation(fields: [requisitoId], references: [id], onDelete: SetNull)
  profissional Profissional?     @relation(fields: [profissionalId], references: [id], onDelete: SetNull)

  @@index([clienteId])
  @@index([servicoId])
  @@index([requisitoId])
  @@index([profissionalId])
  @@index([deletedAt])
}

/// Médico/dentista/psicólogo a CREDENCIAR — pertence a um Cliente (a clínica ou a PJ).
/// Existe porque o credenciamento é por PESSOA: a proposta nomeia cada profissional com a
/// especialidade, e três documentos (conselho, diploma, especializações) repetem por
/// médico. Sem isto, uma clínica com dois médicos aparecia com a papelada completa tendo
/// entregue metade. Ver ADR-103.
model Profissional {
  id                 String   @id @default(cuid())
  clienteId          String
  nome               String
  conselho           String // CRM | CRO | CRP | CRN | CREFITO | CRFA (validado em @app/shared)
  conselhoNumero     String?
  conselhoUf         String?  @db.VarChar(2)
  especialidade      String? // entra na proposta ("cardiologista")
  anoFormatura       Int? // R5 da triagem: 5 anos de formado
  tituloEspecialista Boolean  @default(false) // R6: declarado; o comprovante é a exigência "Especializações"
  responsavelTecnico Boolean  @default(false) // quem responde pelo currículo do responsável técnico
  ativo              Boolean  @default(true) // desligar sem apagar histórico
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  cliente         Cliente          @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  arquivos        Arquivo[]
  credenciamentos Credenciamento[]

  @@index([clienteId])
}

/// Andamento de UM credenciamento na operadora. `NEGADO` encerra aquele cruzamento (spec §3.4:
/// "após uma tentativa e negativa, o credenciamento se encerra, salvo acordo expresso"); voltar a
/// tentar é uma linha NOVA com `tentativa` 2, e não a mesma linha reaberta — senão o histórico da
/// primeira negativa seria sobrescrito, e é exatamente ele que justifica cobrar de novo.
enum StatusCredenciamento {
  A_PROTOCOLAR
  PROTOCOLADO
  EM_ANALISE
  APROVADO
  NEGADO
  ENCERRADO
}

/// A GRADE médico × operadora: cada cruzamento é uma linha. Uma peça, três funções — monta o
/// preço da proposta (`valor` por célula), acompanha o andamento (`status`) e dispara a cobrança
/// (`contaId`, criada só na aprovação — spec §6.3, o honorário é no sucesso). Ver ADR-104.
model Credenciamento {
  id             String               @id @default(cuid())
  clienteId      String
  profissionalId String
  operadoraId    String
  valor          Decimal              @default(0) @db.Decimal(12, 2)
  status         StatusCredenciamento @default(A_PROTOCOLAR)
  /// 1 por padrão. A 2ª exige o acordo expresso do §3.4, com o motivo gravado em `observacoes`.
  tentativa      Int                  @default(1)
  /// A proposta que originou esta linha. SetNull: apagar a proposta não apaga o andamento real.
  documentoId    String?
  /// A conta a receber criada na APROVAÇÃO. SetNull: apagar a conta não apaga o credenciamento.
  contaId        String?
  protocoladoEm  DateTime?
  emAnaliseEm    DateTime?
  aprovadoEm     DateTime?
  negadoEm       DateTime?
  encerradoEm    DateTime?
  motivoNegativa String?              @db.Text
  observacoes    String?              @db.Text
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  cliente      Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  profissional Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  // Restrict de propósito: excluir do catálogo uma operadora com credenciamento em curso
  // apagaria o andamento. O serviço traduz o erro do banco em recado explicável.
  operadora    Operadora    @relation(fields: [operadoraId], references: [id], onDelete: Restrict)
  documento    Documento?   @relation(fields: [documentoId], references: [id], onDelete: SetNull)
  conta        Conta?       @relation(fields: [contaId], references: [id], onDelete: SetNull)

  /// Não existem duas linhas para o mesmo par na mesma tentativa.
  @@unique([profissionalId, operadoraId, tentativa])
  @@index([clienteId, status])
  @@index([documentoId])
  @@index([operadoraId])
  @@index([contaId])
}

/// De quem o sistema está esperando para o passo andar.
///
/// MED = é a nossa vez de agir. CLIENTE = está parado esperando a clínica entregar,
/// responder ou aprovar. Sem esta distinção, a pergunta que a Thaís faz toda manhã —
/// *o que está parado esperando o cliente?* — só se responde abrindo lead por lead.
enum QuemFaz {
  MED
  CLIENTE
}

/// Passo padrão de um serviço, atrelado a uma etapa do funil. Ao um lead escolher
/// o serviço, estes passos entram no checklist da etapa correspondente. Editável.
model ServicoPasso {
  id          String   @id @default(cuid())
  servicoId   String
  titulo      String
  obrigatorio Boolean  @default(false)
  etapaChave  String // "novo"|"qualificacao"|"proposta"|"negociacao"|"fechado"
  // Padrão MED de propósito: passo novo criado à mão pela equipe é trabalho nosso até
  // alguém dizer o contrário. Errar para este lado mostra um passo a mais na nossa fila;
  // errar para o outro faria a Thaís achar que está esperando o cliente e não cobrar nada.
  quemFaz     QuemFaz  @default(MED)
  ordem       Int      @default(0)
  createdAt   DateTime @default(now())

  servico Servico @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  @@index([servicoId, etapaChave])
}

/// Lead (oportunidade). Percorre o pipeline até virar Cliente.
model Lead {
  id                        String    @id @default(cuid())
  nome                      String
  // Razão social / nome da clínica. Todo cliente da Med é PJ (ADR-119): esta é a conta
  // que vai nascer na conversão; `nome` é a PESSOA com quem se fala.
  empresa                   String?
  cnpj                      String? // CNPJ da clínica, opcional no 1º contato (ADR-119)
  email                     String?
  telefone                  String?
  origem                    String?
  // Rastreio de atribuição (UTM/referrer capturados na captação) — de onde veio.
  rastreio                  String?   @db.Text
  valorEstimado             Decimal?  @db.Decimal(12, 2) // estimativa comercial (não é contábil — ver Financeiro/Fase 4)
  // Faturamento mensal da clínica, estimado na Qualificação. Só é perguntado quando TODOS os
  // serviços do lead são percentuais (hoje: só o Faturamento de contas médicas) — ali não existe
  // valor fixo a estimar, e é DESTE número que sai o `valorEstimado` acima, pela conta
  // faturamento × percentual. Ver ADR-125 e `planejarEstimativaDoLead` em @app/shared.
  faturamentoMensalEstimado Decimal?  @db.Decimal(12, 2)
  observacoes               String?   @db.Text
  ordem                     Int       @default(0) // posição dentro da coluna
  pipelineStageId           String
  responsavelId             String?
  convertidoEmClienteId     String?
  // Quando o lead virou cliente (data do ganho) — alimenta o "cliente desde" na ficha.
  convertidoEm              DateTime?
  // Perda (lado oposto do ganho): quando marcado, o lead sai do funil ativo e alimenta
  // o relatório de ganho/perda. Reversível (reabrir limpa os dois campos).
  perdidoEm                 DateTime?
  motivoPerda               String?
  // Conta/cliente ligada (Portal do prospect). Independe de ganho/perdido — o lead
  // continua no funil enquanto convertidoEmClienteId for nulo.
  clienteId                 String?
  /// LGPD (ADR-141) — o aviso de privacidade que a pessoa aceitou ao se cadastrar em
  /// /comecar, e QUAL versão dele. Guardar só a data não prova nada: o texto muda, e a
  /// prova do consentimento é a data MAIS a versão vigente naquele dia. Nulo nos leads
  /// anteriores à regra e nos cadastrados à mão pela equipe (que não passam pelo site).
  privacidadeAceitaEm       DateTime?
  privacidadeVersao         String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  deletedAt                 DateTime?

  pipelineStage       PipelineStage @relation(fields: [pipelineStageId], references: [id])
  responsavel         User?         @relation("LeadResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  convertidoEmCliente Cliente?      @relation("LeadConvertido", fields: [convertidoEmClienteId], references: [id], onDelete: SetNull)
  clientePortal       Cliente?      @relation("LeadClientePortal", fields: [clienteId], references: [id], onDelete: SetNull)
  servicos            Servico[]     @relation("LeadServicos")
  passos              LeadPasso[]

  @@index([pipelineStageId, ordem])
  @@index([responsavelId])
  @@index([clienteId])
  @@index([deletedAt])
}

/// Passo do checklist de um lead numa etapa (os "próximos passos" do card).
/// Semeado a partir do playbook padrão da etapa; editável por lead. Os passos
/// `obrigatorio` são os critérios de saída — concluídos todos, o lead avança.
model LeadPasso {
  id             String    @id @default(cuid())
  leadId         String
  stageId        String
  // Origem: null = passo geral da etapa; senão = do serviço (para agrupar/rotular).
  servicoId      String?
  titulo         String
  obrigatorio    Boolean   @default(false)
  // Cópia do `quemFaz` do ServicoPasso no momento em que o passo foi materializado.
  // É cópia, e não um join, porque o passo pode ser criado à mão (sem serviço por trás)
  // e porque mudar o catálogo depois não deve reescrever o histórico de um lead em curso.
  quemFaz        QuemFaz   @default(MED)
  // Ação de documento ligada ao passo (briefing|proposta|contrato) + documento gerado.
  acaoDoc        String?
  documentoId    String?
  // Regra de automação (null = passo manual). Ex.: "servicos", "valor" — o sistema
  // conclui/reabre sozinho conforme o estado do lead (passo derivado, reversível).
  autoRegra      String?
  ordem          Int       @default(0)
  concluido      Boolean   @default(false)
  concluidoEm    DateTime?
  concluidoPorId String?
  createdAt      DateTime  @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, stageId])
}

// ─────────────────────────────────────────────────────────────
// Projetos + Kanban + Timer (Fase 2)
// ─────────────────────────────────────────────────────────────

enum ProjetoStatus {
  ATIVO
  PAUSADO
  CONCLUIDO
}

/// Colunas do kanban de projeto — fluxo de trabalho claro em etapas.
enum CardStatus {
  A_FAZER
  EM_ANDAMENTO
  AGUARDANDO_CLIENTE
  AGUARDANDO_TERCEIROS
  CONCLUIDO
}

enum Prioridade {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

/// Projeto de um cliente. Contém o kanban de tarefas.
model Projeto {
  id            String        @id @default(cuid())
  clienteId     String
  nome          String
  descricao     String?       @db.Text
  status        ProjetoStatus @default(ATIVO)
  responsavelId String?
  // Serviço de origem: um projeto = um serviço contratado do cliente (ADR-38). Nulo em
  // projetos gerais/manuais. Liga a automação (não recria o projeto do mesmo serviço).
  servicoId     String?
  inicio        DateTime?
  previsaoFim   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  cliente       Cliente               @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  responsavel   User?                 @relation("ProjetoResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  servico       Servico?              @relation(fields: [servicoId], references: [id], onDelete: SetNull)
  participantes ProjetoParticipante[]
  cards         Card[]
  eventos       Evento[]
  documentos    Documento[]
  tarefas       Tarefa[]

  @@index([clienteId])
  @@index([responsavelId])
  @@index([servicoId])
  @@index([deletedAt])
}

/// Participantes de um projeto (equipe que gerencia/acompanha). Além do responsável,
/// permite mais de uma pessoa por projeto (inspirado nos "project members" do Perfex).
model ProjetoParticipante {
  id        String   @id @default(cuid())
  projetoId String
  userId    String
  createdAt DateTime @default(now())

  projeto Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projetoId, userId])
  @@index([userId])
}

/// Cartão/tarefa do kanban.
model Card {
  id            String     @id @default(cuid())
  projetoId     String
  titulo        String
  descricao     String?    @db.Text
  status        CardStatus @default(A_FAZER)
  prioridade    Prioridade @default(MEDIA)
  responsavelId String?
  // Serviço de origem (quando o card foi gerado a partir de um serviço contratado) —
  // liga o card à automação: entregas do cliente + passos do serviço, status automático.
  servicoId     String?
  prazo         DateTime?
  ordem         Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  projeto     Projeto         @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  responsavel User?           @relation("CardResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  servico     Servico?        @relation(fields: [servicoId], references: [id], onDelete: SetNull)
  checklist   ChecklistItem[]
  timeEntries TimeEntry[]

  @@index([projetoId, status, ordem])
  @@index([responsavelId])
  @@index([servicoId])
  @@index([deletedAt])
}

/// Item de checklist de um cartão.
model ChecklistItem {
  id          String   @id @default(cuid())
  cardId      String
  texto       String
  concluido   Boolean  @default(false)
  // Se preenchido, este item de checklist é uma ENTREGA DO CLIENTE (exigência do serviço):
  // marca-se sozinho quando o cliente entrega e não é editável manualmente pela equipe.
  requisitoId String?
  ordem       Int      @default(0)
  createdAt   DateTime @default(now())

  card      Card              @relation(fields: [cardId], references: [id], onDelete: Cascade)
  requisito ServicoRequisito? @relation(fields: [requisitoId], references: [id], onDelete: SetNull)

  @@index([cardId])
  @@index([requisitoId])
}

/// Registro de tempo (Timer). Uma sessão inicio→fim por vez.
model TimeEntry {
  id         String    @id @default(cuid())
  cardId     String?
  userId     String
  inicio     DateTime  @default(now())
  fim        DateTime?
  duracaoSeg Int?
  descricao  String?
  createdAt  DateTime  @default(now())

  card Card? @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Agenda + Notificações (Fase 3)
// ─────────────────────────────────────────────────────────────

enum EventoTipo {
  COMPROMISSO
  RETORNO
  REUNIAO
  LEMBRETE
  PESSOAL
}

enum EventoEscopo {
  PESSOAL
  EMPRESA
}

enum Recorrencia {
  NENHUMA
  DIARIA
  SEMANAL
  MENSAL
}

/// Evento da agenda (compromisso, retorno, reunião, lembrete, pessoal).
model Evento {
  id                     String       @id @default(cuid())
  titulo                 String
  descricao              String?      @db.Text
  tipo                   EventoTipo   @default(COMPROMISSO)
  escopo                 EventoEscopo @default(EMPRESA)
  inicio                 DateTime
  fim                    DateTime?
  diaInteiro             Boolean      @default(false)
  local                  String?
  linkReuniao            String?
  recorrencia            Recorrencia  @default(NENHUMA)
  recorrenciaAte         DateTime?
  donoId                 String
  clienteId              String?
  projetoId              String?
  lembreteEnviado        Boolean      @default(false)
  // Lembrete por e-mail ao cliente (véspera/no dia). Só eventos não recorrentes.
  lembreteClienteEnviado Boolean      @default(false)
  // Cliente confirmou presença pelo Portal (nulo = ainda não respondeu).
  clienteConfirmadoEm    DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  deletedAt              DateTime?

  dono          User                 @relation("EventoDono", fields: [donoId], references: [id], onDelete: Cascade)
  cliente       Cliente?             @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  projeto       Projeto?             @relation(fields: [projetoId], references: [id], onDelete: SetNull)
  participantes EventoParticipante[]

  @@index([donoId])
  @@index([inicio])
  @@index([clienteId])
  @@index([deletedAt])
}

/// Participante (membro da equipe) de um evento — além do dono. Cada participante
/// vê o evento na própria agenda e recebe o lembrete.
model EventoParticipante {
  id       String @id @default(cuid())
  eventoId String
  userId   String

  evento Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventoId, userId])
  @@index([userId])
}

/// Notificação empurrada em tempo real (Socket.IO) e persistida.
model Notificacao {
  id           String   @id @default(cuid())
  userId       String
  tipo         String
  titulo       String
  corpo        String?
  entidadeTipo String?
  entidadeId   String?
  lida         Boolean  @default(false)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lida])
  @@index([createdAt])
}

enum EmailStatus {
  ENVIADO
  FALHOU
}

/// Histórico de TODO e-mail enviado pelo sistema, para exibir por destinatário
/// (lead, cliente, usuário) e supervisão. Vinculado pelo e-mail no momento do envio.
/// Ids sem FK (é um log — sobrevive à exclusão das entidades).
model EmailEnviado {
  id        String      @id @default(cuid())
  para      String
  assunto   String
  template  String?
  corpo     String      @db.Text
  status    EmailStatus @default(ENVIADO)
  // Motivo da falha (mensagem do SMTP ou "modo dev") — só preenchido quando FALHOU.
  erro      String?     @db.Text
  userId    String?
  clienteId String?
  leadId    String?
  createdAt DateTime    @default(now())

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([clienteId, createdAt])
  @@index([leadId, createdAt])
  @@index([para])
}

// ─────────────────────────────────────────────────────────────
// Financeiro (Fase 4)
// ─────────────────────────────────────────────────────────────

enum ContaTipo {
  PAGAR
  RECEBER
}

enum CategoriaTipo {
  RECEITA
  DESPESA
}

/// Carteira financeira: livros da empresa (compartilhados) ou finanças pessoais (privadas por usuário).
enum Escopo {
  EMPRESA
  PESSOAL
}

/// Categoria financeira (receita ou despesa).
model Categoria {
  id        String        @id @default(cuid())
  nome      String
  tipo      CategoriaTipo
  escopo    Escopo        @default(EMPRESA)
  donoId    String?
  cor       String?
  createdAt DateTime      @default(now())

  contas Conta[]
  dono   User?   @relation("CategoriaDono", fields: [donoId], references: [id], onDelete: Cascade)

  @@index([tipo])
  @@index([escopo, donoId, tipo])
}

/// Conta a pagar ou a receber.
model Conta {
  id             String      @id @default(cuid())
  tipo           ContaTipo
  escopo         Escopo      @default(EMPRESA)
  donoId         String? // dono da carteira PESSOAL (null = EMPRESA, compartilhada)
  descricao      String
  valor          Decimal     @db.Decimal(12, 2)
  vencimento     DateTime
  pago           Boolean     @default(false)
  pagoEm         DateTime?
  categoriaId    String?
  clienteId      String?
  recorrencia    Recorrencia @default(NENHUMA)
  // QUE SERVIÇO ORIGINOU ESTA COBRANÇA. Existe porque a conferência que impede cobrar duas
  // vezes o mesmo serviço casava por TEXTO da descrição ("<Serviço> — <Cliente>"): renomear o
  // cliente na ficha mudava a descrição das cobranças futuras, a conferência deixava de casar
  // com as antigas, e aceitar uma segunda proposta que repetisse o serviço lançava a cobrança
  // de novo — em silêncio, porque duas contas a receber com descrições diferentes não parecem
  // duplicata para ninguém. Nulo nas contas anteriores a esta coluna e nas que não vêm de um
  // serviço (aluguel, imposto): por isso a conferência olha as DUAS coisas.
  origemServicoId String?
  recorrenciaAte DateTime? // limite opcional da série recorrente
  recorrenteId   String? // id da 1ª conta da série (herdado pelas geradas); agrupa a série
  observacoes    String?     @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  categoria       Categoria?       @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  cliente         Cliente?         @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  dono            User?            @relation("ContaDono", fields: [donoId], references: [id], onDelete: Cascade)
  credenciamentos Credenciamento[]

  // Uma série não pode ter DUAS parcelas no mesmo vencimento. Vale para toda a tabela,
  // inclusive linhas soft-deletadas — por isso a geração ressuscita a apagada em vez de
  // criar outra (ADR-92). Conta não-recorrente tem recorrenteId nulo e fica de fora
  // (o MySQL trata NULL como distinto em índice único).
  @@unique([recorrenteId, vencimento])
  @@index([tipo, pago])
  @@index([vencimento])
  @@index([clienteId])
  @@index([deletedAt])
  @@index([escopo, donoId])
  @@index([recorrenteId])
  @@index([clienteId, origemServicoId])
}

// ─────────────────────────────────────────────────────────────
// Mensagens Internas (Fase 6)
// ─────────────────────────────────────────────────────────────

enum ConversaTipo {
  INDIVIDUAL
  GRUPO
  PROJETO
  CLIENTE
}

/// Status do chamado (só conversas tipo CLIENTE — suporte do cliente/lead).
/// RESOLVIDO = fechado/arquivado no histórico (reabrível).
enum ChamadoStatus {
  ABERTO
  EM_ANDAMENTO
  RESOLVIDO
}

/// Prioridade do chamado (helpdesk).
enum ChamadoPrioridade {
  BAIXA
  NORMAL
  ALTA
}

model Conversa {
  id            String            @id @default(cuid())
  tipo          ConversaTipo
  nome          String?
  projetoId     String?
  clienteId     String?
  // Campos de "chamado/ticket" (só tipo CLIENTE): protocolo, assunto, status,
  // prioridade, responsável e quando foi resolvido (histórico). Um cliente/lead
  // pode ter VÁRIOS chamados ao longo do tempo (helpdesk — ADR-41).
  numero        Int?
  assunto       String?
  status        ChamadoStatus     @default(ABERTO)
  prioridade    ChamadoPrioridade @default(NORMAL)
  responsavelId String?
  resolvidoEm   DateTime?
  // Quem criou (admin do grupo — pode renomear/gerir membros).
  criadoPorId   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?

  cliente     Cliente? @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  responsavel User?    @relation("ConversaResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  criadoPor   User?    @relation("ConversaCriador", fields: [criadoPorId], references: [id], onDelete: SetNull)

  participantes ConversaParticipante[]
  mensagens     Mensagem[]

  @@index([updatedAt])
  @@index([clienteId])
  @@index([numero])
}

model ConversaParticipante {
  id              String    @id @default(cuid())
  conversaId      String
  userId          String
  ultimaLeituraEm DateTime?
  // Preferências por usuário (estilo WhatsApp): fixar, silenciar, arquivar, ocultar
  // ("apagar conversa" só para mim — reaparece se chegar mensagem nova).
  fixadoEm        DateTime?
  silenciadoEm    DateTime?
  arquivadoEm     DateTime?
  ocultoEm        DateTime?
  createdAt       DateTime  @default(now())

  conversa Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversaId, userId])
  @@index([userId])
}

model Mensagem {
  id         String    @id @default(cuid())
  conversaId String
  autorId    String
  conteudo   String    @db.Text
  editadoEm  DateTime?
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  conversa Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  autor    User     @relation(fields: [autorId], references: [id], onDelete: Cascade)

  @@index([conversaId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Tarefas (delegação interna — ADR-88)
// ─────────────────────────────────────────────────────────────

enum TarefaStatus {
  PENDENTE
  FAZENDO
  CONCLUIDA
}

enum TarefaPrioridade {
  BAIXA
  NORMAL
  ALTA
}

/// Tarefa/pedido interno delegado entre a equipe. NÃO é entrega de cliente (isso é
/// Projeto/Card) nem compromisso com hora marcada (Agenda) — é o "me resolve isso".
/// `criadoPor` = quem pediu/delegou; `responsavel` = quem faz. Cliente/projeto são
/// contexto OPCIONAL (a tarefa pode ser puramente interna, sem vínculo).
model Tarefa {
  id          String           @id @default(cuid())
  titulo      String
  descricao   String?          @db.Text
  criadoPorId String
  prazo       DateTime?
  prioridade  TarefaPrioridade @default(NORMAL)
  status      TarefaStatus     @default(PENDENTE)
  clienteId   String?
  projetoId   String?
  concluidaEm DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  criadoPor    User                @relation("TarefaCriador", fields: [criadoPorId], references: [id], onDelete: Cascade)
  cliente      Cliente?            @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  projeto      Projeto?            @relation(fields: [projetoId], references: [id], onDelete: SetNull)
  // Uma tarefa pode ser de VÁRIOS responsáveis (tarefa "da equipe").
  responsaveis TarefaResponsavel[]
  // Reserva de idempotência da API do agente (CORA-003). Some junto se a tarefa for apagada.
  idempotencias AgentIdempotency[]

  @@index([criadoPorId, status])
  @@index([clienteId])
  @@index([projetoId])
  @@index([prazo])
  @@index([deletedAt])
}

/// Responsáveis de uma tarefa (N por tarefa). Junção Tarefa↔User.
model TarefaResponsavel {
  id       String @id @default(cuid())
  tarefaId String
  userId   String

  tarefa Tarefa @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tarefaId, userId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Documentos Inteligentes (Fase 7 — IA pluga na Fase 9)
// ─────────────────────────────────────────────────────────────

enum TipoModelo {
  PROPOSTA
  CONTRATO
  BRIEFING
  ESCOPO
  ONBOARDING
  CHECKLIST
  ATA
  RELATORIO
  PAUTA_REUNIAO
  PAUTA_POSTAGEM
  RECIBO
  DIAGNOSTICO
  PLANO_ACAO
}

enum StatusDocumento {
  RASCUNHO
  EM_REVISAO
  APROVADO
  ENVIADO
}

enum OrigemVersao {
  MANUAL
  IA
}

/// Modelo de documento com placeholders {{...}}.
model ModeloDocumento {
  id                 String     @id @default(cuid())
  nome               String
  tipo               TipoModelo
  corpo              String     @db.Text
  ativo              Boolean    @default(true)
  // true quando a equipe editou o modelo — a semente NUNCA sobrescreve o que foi editado.
  editadoManualmente Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  documentos Documento[]
}

/// Documento gerado. Fluxo: rascunho → em revisão → aprovado → enviado.
model Documento {
  id                     String          @id @default(cuid())
  modeloId               String?
  clienteId              String?
  projetoId              String?
  titulo                 String
  conteudo               String          @db.Text
  status                 StatusDocumento @default(RASCUNHO)
  /// Número sequencial da proposta, exibido com 4 dígitos ("0225"). Continua a contagem MANUAL
  /// da Thaís, que estava em 224 em 10/08/2026 — a primeira emitida pelo sistema é a 0225.
  /// Único e opcional: só a proposta de credenciamento numera; o resto fica nulo (ADR-104).
  numero                 Int?            @unique
  // Opcional + SetNull: excluir o usuário criador PRESERVA o documento (propostas/contratos
  // não podem sumir junto com um funcionário desligado). Ver decisão #1 da finalização.
  criadoPorId            String?
  aprovadoPorId          String?
  enviadoEm              DateTime?
  // Assinatura digital (Fase 3)
  assinaturaSolicitadaEm DateTime?
  assinadoEm             DateTime?
  // Aceite online da PROPOSTA (Fase C — ADR-47): link público token + trilha de auditoria.
  propostaToken          String?         @unique
  propostaStatus         String? // PENDENTE | ACEITA | RECUSADA
  propostaHash           String? // sha256 do conteúdo no momento em que o aceite foi habilitado
  propostaSolicitadaEm   DateTime?
  propostaRespondidaEm   DateTime?
  propostaRespIp         String?
  // QUEM respondeu, quando a pessoa estava logada (ADR-137). Nulo no caminho normal — o link
  // de e-mail é anônimo, e IP não identifica ninguém. Desde que cada pessoa da clínica tem
  // conta própria (ADR-131), "quem aceitou" deixou de ser a clínica e passou a ser gente.
  propostaRespPorId      String?
  propostaRespPor        User?           @relation("PropostasRespondidas", fields: [propostaRespPorId], references: [id], onDelete: SetNull)
  propostaMotivoRecusa   String?         @db.Text
  // Itens estruturados do documento (proposta/contrato): serviços + valores + recorrência.
  // Fonte da verdade estruturada por trás do Markdown — permite o aceite sincronizar
  // ClienteServico e o contrato refletir exatamente o que foi proposto/aceito. Ver ADR-81.
  itens                  Json?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  deletedAt              DateTime?

  modelo          ModeloDocumento?  @relation(fields: [modeloId], references: [id], onDelete: SetNull)
  cliente         Cliente?          @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  projeto         Projeto?          @relation(fields: [projetoId], references: [id], onDelete: SetNull)
  criadoPor       User?             @relation("DocCriador", fields: [criadoPorId], references: [id], onDelete: SetNull)
  aprovadoPor     User?             @relation("DocAprovador", fields: [aprovadoPorId], references: [id], onDelete: SetNull)
  versoes         DocumentoVersao[]
  assinaturas     Assinatura[]
  credenciamentos Credenciamento[]

  @@index([status])
  @@index([clienteId])
  @@index([deletedAt])
}

/// Assinatura eletrônica "avançada" (Lei 14.063/2020) de um documento por um
/// signatário. Guarda a trilha de auditoria (IP, user-agent, data/hora) e o HASH
/// do conteúdo no momento do envio — prova de integridade (documento não alterado).
model Assinatura {
  id            String    @id @default(cuid())
  documentoId   String
  papel         String // "CLIENTE" | "MEDCONSULTORIA"
  nome          String
  email         String?
  ordem         Int       @default(0)
  // Token público do link de assinatura. Gerado na aplicação por `gerarTokenPublico()`
  // (randomBytes 256-bit, criptográfico) — ver decisão #2. Sem @default(cuid()) de propósito.
  token         String    @unique
  status        String    @default("PENDENTE") // PENDENTE | ASSINADO
  metodo        String? // "DESENHO" | "DIGITADO"
  imagem        String?   @db.Text // data-URI PNG do traço (quando DESENHO)
  nomeDigitado  String?
  hashDocumento String? // sha256 do conteúdo no envio
  ip            String?
  userAgent     String?   @db.Text
  // QUEM clicou, quando a pessoa estava logada (ADR-137). Nulo no caminho normal (link de
  // e-mail, sem login). IP e user-agent dizem de onde veio, nunca quem foi.
  assinadoPorId String?
  assinadoEm    DateTime?
  // A PROVA DO CONSENTIMENTO. A caixa "li e concordo" sempre foi exigida pela tela e pelo
  // servidor, e nada disso ficava gravado: depois do clique não sobrava no sistema nenhum
  // registro de que a pessoa consentiu, nem com que texto. Guarda a data E a versão do texto
  // (`VERSAO_CONSENTIMENTO_ASSINATURA`, em `@app/shared`) — só a data não diria com o quê.
  // Nulo nas assinaturas anteriores a esta coluna: elas foram dadas, o consentimento foi
  // exigido na tela, mas a prova não existe e inventá-la seria pior que a ausência.
  consentimentoEm      DateTime?
  consentimentoVersao  String?
  criadoEm      DateTime  @default(now())

  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  assinadoPor User?     @relation("AssinaturasFeitas", fields: [assinadoPorId], references: [id], onDelete: SetNull)

  @@index([documentoId])
}

/// Histórico de versões do conteúdo (origem MANUAL ou IA).
model DocumentoVersao {
  id          String       @id @default(cuid())
  documentoId String
  conteudo    String       @db.Text
  autorId     String?
  origem      OrigemVersao @default(MANUAL)
  createdAt   DateTime     @default(now())

  documento Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  autor     User?     @relation(fields: [autorId], references: [id], onDelete: SetNull)

  @@index([documentoId])
}

// ─────────────────────────────────────────────────────────────
// E-mail dentro da aplicação (IMAP por usuário) — ver
// docs/superpowers/specs/2026-08-03-email-na-aplicacao-design.md

enum CaixaEstado {
  OK
  AUTENTICACAO_FALHOU
  ERRO
}

enum PastaPapel {
  INBOX
  SENT
  DRAFTS
  TRASH
  JUNK
  ARCHIVE
}

enum EnderecoPapel {
  DE
  PARA
  CC
  CCO
  RESPONDER_A
}

/// Caixa de e-mail que UM usuário plugou na própria conta. A privacidade nasce do `userId`:
/// ninguém enxerga caixa de ninguém. Duas pessoas podem plugar o MESMO endereço (ex.: contato@)
/// — são duas linhas, e o servidor de e-mail é quem concilia (é a mesma caixa de verdade).
model CaixaEmail {
  id            String      @id @default(cuid())
  userId        String
  email         String
  rotulo        String?
  nomeExibicao  String
  assinatura    String?     @db.Text
  imapHost      String
  imapPorta     Int         @default(993)
  smtpHost      String
  smtpPorta     Int         @default(465)
  usuario       String
  /// Senha cifrada (AES-256-GCM, ver lib/cripto-caixa.ts). NUNCA sai da API.
  segredo       String      @db.Text
  padrao        Boolean     @default(false)
  ativa         Boolean     @default(true)
  estado        CaixaEstado @default(OK)
  ultimoErro    String?     @db.Text
  ultimaSyncEm  DateTime?
  /// Limite para trás da sincronização. Padrão = 90 dias atrás no momento de plugar.
  importarDesde DateTime?
  createdAt     DateTime    @default(now())
  deletedAt     DateTime?

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pastas CaixaPasta[]

  @@unique([userId, email])
  @@index([userId, ativa])
}

/// Uma pasta da caixa, com os ponteiros de sincronização do IMAP.
model CaixaPasta {
  id            String      @id @default(cuid())
  caixaId       String
  caminho       String
  nome          String
  papel         PastaPapel?
  uidValidity   BigInt      @default(0)
  ultimoUid     BigInt      @default(0)
  highestModseq BigInt      @default(0)
  naoLidos      Int         @default(0)
  total         Int         @default(0)
  ordem         Int         @default(0)
  sincronizando DateTime?

  caixa     CaixaEmail      @relation(fields: [caixaId], references: [id], onDelete: Cascade)
  mensagens EmailMensagem[]

  @@unique([caixaId, caminho])
  @@index([caixaId, ordem])
}

/// Índice de uma mensagem. O corpo é CACHE: nulo até alguém abrir.
model EmailMensagem {
  id          String    @id @default(cuid())
  caixaId     String
  pastaId     String
  uid         BigInt
  messageId   String?   @db.VarChar(512)
  inReplyTo   String?   @db.VarChar(512)
  referencias String?   @db.Text
  threadKey   String?   @db.VarChar(512)
  deNome      String?
  deEmail     String
  assunto     String?   @db.Text
  trecho      String?   @db.Text
  dataEm      DateTime
  lido        Boolean   @default(false)
  respondido  Boolean   @default(false)
  temAnexo    Boolean   @default(false)
  tamanho     Int?
  corpoHtml   String?   @db.LongText
  corpoTexto  String?   @db.LongText
  corpoEm     DateTime?
  /// Marcada como particular pelo dono: sai da ficha do cliente (usado no bloco do CRM).
  particular  Boolean   @default(false)
  createdAt   DateTime  @default(now())

  pasta     CaixaPasta      @relation(fields: [pastaId], references: [id], onDelete: Cascade)
  enderecos EmailEndereco[]
  anexos    EmailAnexo[]

  @@unique([pastaId, uid])
  // A consulta que a tela faz o tempo todo: mensagens DA PASTA, mais recentes primeiro.
  // `(pastaId, uid)` casa a pasta mas não ordena por data, e `(caixaId, dataEm)` não filtra
  // por pasta — sem este índice, cada abertura e cada polling faziam filesort.
  @@index([pastaId, dataEm])
  @@index([caixaId, dataEm])
  @@index([threadKey])
}

/// Todos os endereços de uma mensagem. O vínculo com Cliente/Lead é resolvido por JOIN
/// neste endereço na hora de consultar — nunca gravado fixo (ver §5.4 do desenho).
model EmailEndereco {
  id         String        @id @default(cuid())
  mensagemId String
  papel      EnderecoPapel
  nome       String?
  endereco   String

  mensagem EmailMensagem @relation(fields: [mensagemId], references: [id], onDelete: Cascade)

  @@index([endereco])
  @@index([mensagemId])
}

/// Metadado do anexo. O CONTEÚDO não é guardado — é buscado no IMAP na hora do download.
model EmailAnexo {
  id         String  @id @default(cuid())
  mensagemId String
  nome       String
  tipo       String
  tamanho    Int
  parte      String
  cid        String?
  arquivoId  String?

  mensagem EmailMensagem @relation(fields: [mensagemId], references: [id], onDelete: Cascade)

  @@index([mensagemId])
}

// ─────────────────────────────────────────────────────────────
// API DO AGENTE (ADR-149) — como a Cora fala com o Workspace
// ─────────────────────────────────────────────────────────────

/// IDENTIDADE DO SERVIÇO que chama a API do agente (hoje: a Cora).
///
/// ⚠️ É a metade que responde "QUEM É O PROGRAMA", nunca "QUEM É A PESSOA". As duas coisas são
/// separadas de propósito: um segredo de serviço vazado não pode virar acesso ao dado de
/// ninguém sem a delegação da pessoa, e uma delegação vazada não serve a outro programa
/// (ela é presa a este `AgentClient`).
model AgentClient {
  id         String    @id @default(cuid())
  nome       String    @unique
  /// SHA-256 do segredo, em hex. NUNCA o segredo. Ver o comentário sobre argon2 no serviço.
  ///
  /// ⚠️ **`utf8mb4_bin` de propósito.** A colação da casa é `utf8mb4_unicode_ci`, que **ignora
  /// maiúscula e acento** — foi o que mordeu na ADR-147. Aqui a função de hash sempre devolve
  /// hex minúsculo, então hoje não haveria colisão; o problema é a coluna depender disso. Esta é
  /// a âncora de autenticação: se um dia o formato virar base64 (onde caixa É significativa) ou
  /// alguém gravar por outro caminho, a comparação passaria a casar valores diferentes **sem
  /// erro nenhum**. Colação binária fecha isso na estrutura, não na disciplina.
  segredoHash String   @unique @db.VarChar(191)
  ativo      Boolean   @default(true)
  revogadoEm DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  delegacoes AgentDelegation[]
  idempotencias AgentIdempotency[]
}

/// RESERVA DE IDEMPOTÊNCIA E USO ÚNICO DA APROVAÇÃO — a escrita da Fase 2 (CORA-003).
///
/// ⚠️ **UMA LINHA GUARDA DUAS GARANTIAS DIFERENTES, e é de propósito.**
///
///  1. `@@unique([clientId, userId, ferramenta, chave])` — a **reserva da chave de
///     idempotência**. É este índice, e não um nível de isolamento, que torna a reserva
///     atômica: em `REPEATABLE READ` (o padrão do MySQL/MariaDB) duas conexões que leem e
///     depois inserem **as duas passam** — o clássico "confere e grava" perdido. O índice
///     único é imposto pelo motor de armazenamento e é a única coisa que continua valendo
///     entre conexões diferentes do pool.
///  2. `@@unique([jti])` — o **uso único do `approvalToken`**. O token é assinado e sem
///     estado; o que o consome é o `INSERT` deste `jti`. Reapresentar o mesmo token com
///     OUTRA chave de idempotência colide aqui e é recusado.
///
/// ⚠️ **A LINHA NASCE ANTES DA TAREFA, DENTRO DA MESMA TRANSAÇÃO.** É por isso que
/// `tarefaId` é anulável — e ele nunca é observável nulo de fora: ou a transação inteira
/// entra (reserva + tarefa + vínculo), ou nada entra. Em dois passos, uma queda entre eles
/// deixaria a chave gravada sem tarefa (repetir nunca mais criaria) ou a tarefa sem chave
/// (repetir criaria a segunda) — que é precisamente o que a idempotência existe para impedir.
///
/// ⚠️ **O ESCOPO INCLUI O SERVIÇO E A PESSOA, NUNCA A DELEGAÇÃO.** Presa à delegação, a chave
/// morreria junto com o token — e renovar credencial perderia a idempotência exatamente
/// depois de uma falha, que é quando a repetição é mais provável.
///
/// ⚠️ `ON DELETE CASCADE` no `tarefaId`: se a tarefa deixar de existir de verdade, a reserva
/// vai junto e a chave volta a valer. Coerente — a tarefa aprovada não existe mais.
model AgentIdempotency {
  id       String @id @default(cuid())
  clientId String
  userId   String
  /// Qual capacidade. Hoje só `tasks.create`. Faz parte do escopo da chave para a mesma chave
  /// não significar duas operações diferentes.
  ferramenta String @db.VarChar(64)
  /// A chave escolhida por quem chama (`Idempotency-Key`, UUID v4).
  /// ⚠️ `utf8mb4_bin`: é por ela que o servidor decide "já fiz isto?" (a lição da ADR-147).
  chave    String @db.VarChar(191)
  /// SHA-256 da forma canônica dos argumentos gravados. Mesma chave + argumentos diferentes
  /// é conflito, e é esta coluna que prova a diferença.
  argsHash String @db.VarChar(64)
  /// Identificador do `approvalToken` consumido. `utf8mb4_bin` pelo mesmo motivo.
  jti      String @db.VarChar(64)
  tarefaId String?
  criadaEm DateTime @default(now())
  /// Validade declarada no contrato: 24 h. Passado o prazo a chave é esquecida pelo expurgo e
  /// repetir cria tarefa nova.
  expiraEm DateTime

  client AgentClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User        @relation("IdempotenciaDoAgente", fields: [userId], references: [id], onDelete: Cascade)
  tarefa Tarefa?     @relation(fields: [tarefaId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId, ferramenta, chave], map: "AgentIdempotency_reserva_key")
  @@unique([jti], map: "AgentIdempotency_jti_key")
  @@index([expiraEm])
  @@index([userId])
  @@index([tarefaId])
}

/// DELEGAÇÃO REVOGÁVEL: a pessoa autoriza o serviço a agir em nome dela, por um prazo e com
/// escopos declarados. É daqui que sai o `requesterUserId` — nunca do corpo da requisição.
model AgentDelegation {
  id          String    @id @default(cuid())
  clientId    String
  userId      String
  /// SHA-256 do token, em hex. O valor bruto existe só uma vez, na saída do comando que o emitiu.
  /// ⚠️ `utf8mb4_bin` pelo mesmo motivo de `AgentClient.segredoHash` — e aqui pesa mais: é por
  /// esta coluna que o servidor decide QUEM está chamando.
  tokenHash   String    @unique @db.VarChar(191)
  /// Escopos separados por espaço (ex.: "tasks:read"). Padrão NEGAR: sem o escopo, 403.
  escopos     String    @db.Text
  expiraEm    DateTime
  revogadaEm  DateTime?
  criadaPorId String?
  ultimoUsoEm DateTime?
  createdAt   DateTime  @default(now())

  client      AgentClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user        User        @relation("DelegacaoDoUsuario", fields: [userId], references: [id], onDelete: Cascade)
  criadaPor   User?       @relation("DelegacaoEmitidaPor", fields: [criadaPorId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([clientId])
  // ⚠️ NÃO existe índice em `expiraEm`, e a ausência é deliberada. Ninguém consulta por esse
  // campo: a autenticação acha a linha pelo `tokenHash` e compara a data já com a linha em mãos.
  // Índice que ninguém usa é custo de escrita e mentira sobre a intenção do código. Ele volta
  // junto com o expurgo de delegações vencidas — que, por sua vez, entra quando houver volume
  // (hoje cada delegação é emitida à mão, uma por pessoa). É o mesmo raciocínio da ADR-141:
  // retenção sem rotina não é política de retenção, e rotina sem volume é cerimônia.
}
